/* ---- Carte à points ---- */
.lp{display:flex;align-items:baseline;gap:8px;margin:10px 0 6px}.lp b{font-family:var(--f3);font-size:46px;line-height:1;text-shadow:0 3px 0 rgba(0,0,0,.35)}.lp span{font-family:var(--f3);text-transform:uppercase;letter-spacing:.12em;font-size:13px;opacity:.85}
