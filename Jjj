/* ---- Logo : forme d'origine (plus de rond) ---- */
.brand img{width:auto;height:auto;max-width:min(72vw,280px);max-height:190px;aspect-ratio:auto;object-fit:contain;border:0;border-radius:18px;background:none;box-shadow:none}
/* ---- Relief : bandeau défilant, cartes produits, boutons ---- */
.mq{--mb:color-mix(in srgb,var(--c1) 16%,#141210);position:relative;background:var(--mb);color:#fff;border:1px solid color-mix(in srgb,var(--c1) 70%,transparent);box-shadow:0 8px 22px -8px color-mix(in srgb,var(--c1) 80%,transparent),inset 0 1px 0 rgba(255,255,255,.22);font-size:13px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;margin:6px 0 18px}
.mq div{padding:11px 0}
.mq span{padding:0}
.mq span::after{content:"\2726";color:var(--c2);margin:0 22px;text-shadow:0 0 8px var(--c1)}
.mq::before,.mq::after{content:"";position:absolute;top:0;bottom:0;width:44px;z-index:1;pointer-events:none}
.mq::before{left:0;background:linear-gradient(90deg,var(--mb),transparent)}
.mq::after{right:0;background:linear-gradient(270deg,var(--mb),transparent)}
.pc{position:relative;border:1px solid color-mix(in srgb,var(--c1) 45%,var(--ln));border-radius:18px;background:linear-gradient(160deg,color-mix(in srgb,var(--cd) 82%,#fff),var(--cd) 55%,color-mix(in srgb,var(--cd) 85%,#000));box-shadow:0 4px 0 color-mix(in srgb,var(--c1) 40%,#000),0 16px 24px -12px rgba(0,0,0,.65);transition:transform .25s,box-shadow .25s}
.pc::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.4),inset 0 -1px 0 rgba(0,0,0,.25)}
.pc .ph{position:relative;box-shadow:inset 0 -26px 30px -18px rgba(0,0,0,.55)}
.pc .ph::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.2),transparent 38%)}
.pc .pi{padding:12px 12px 14px}
.pc .pi>b{display:block;font-weight:800;font-size:16px;line-height:1.2}
.pc .pi .mu{display:inline-block;margin-top:8px;padding:4px 11px;border-radius:99px;background:linear-gradient(135deg,var(--c1),var(--c2));color:#fff;font-weight:800;font-size:14px;text-shadow:0 1px 1px rgba(0,0,0,.4);box-shadow:0 4px 10px -3px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.35)}
@media(hover:hover){.pc:hover{transform:perspective(800px) translateY(-7px) rotateX(3deg);box-shadow:0 8px 0 color-mix(in srgb,var(--c1) 40%,#000),0 26px 34px -14px rgba(0,0,0,.7)}}
.pc:active,.pc:hover:active{transform:perspective(800px) translateY(3px) rotateX(5deg) scale(.985);box-shadow:0 1px 0 color-mix(in srgb,var(--c1) 40%,#000),0 6px 12px -6px rgba(0,0,0,.6)}
.hero{box-shadow:0 18px 34px -16px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.25)}
.inf>div,.g2 .cd,.fq{box-shadow:0 8px 18px -10px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.14)}
.b:not(.b2):not(:disabled){box-shadow:0 3px 0 color-mix(in srgb,var(--c1) 55%,#000),0 10px 16px -8px rgba(0,0,0,.6)}
.b:not(.b2):not(:disabled):active{transform:translateY(3px);box-shadow:0 0 0 color-mix(in srgb,var(--c1) 55%,#000)}
/* ---- Relief partout ---- */
.brand b{text-shadow:0 2px 0 color-mix(in srgb,var(--c1) 60%,#000),0 8px 18px rgba(0,0,0,.45)}
.brand img{filter:drop-shadow(0 10px 14px rgba(0,0,0,.5))}
.hero h1{text-shadow:0 2px 0 rgba(0,0,0,.25),0 8px 22px rgba(0,0,0,.45)}
.w:not(.aw)>h2{text-shadow:0 2px 0 rgba(0,0,0,.25)}
.num{text-shadow:0 2px 0 rgba(0,0,0,.2)}
.ch{box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.2)}
.ch.on{box-shadow:0 3px 0 color-mix(in srgb,var(--c1) 60%,#000),inset 0 1px 0 rgba(255,255,255,.25)}
.ch:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.35)}
.b2{box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.18)}
.b2:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.35)}
.cd,.tx,.lab,.wn,.bm{box-shadow:0 8px 18px -10px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.14)}
.pr{box-shadow:0 4px 0 color-mix(in srgb,var(--c2) 55%,#000),0 12px 18px -10px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.35)}
.bm.u{background:linear-gradient(135deg,var(--c1),color-mix(in srgb,var(--c1) 65%,#000))}
.nb{background:linear-gradient(145deg,var(--c1),color-mix(in srgb,var(--c1) 60%,#000));box-shadow:0 3px 0 color-mix(in srgb,var(--c1) 40%,#000),inset 0 1px 0 rgba(255,255,255,.4);text-shadow:0 1px 1px rgba(0,0,0,.4)}
.em2{filter:drop-shadow(0 4px 4px rgba(0,0,0,.4))}
@media(hover:hover){.g2 .cd{transition:transform .25s,box-shadow .25s}.g2 .cd:hover{transform:translateY(-5px);box-shadow:0 18px 26px -12px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.2)}}
input:not([type=checkbox]):not([type=radio]):not([type=color]):not([type=file]),select,textarea{box-shadow:inset 0 2px 5px rgba(0,0,0,.3),0 1px 0 rgba(255,255,255,.12)}
.sh{border-top:1px solid color-mix(in srgb,var(--c1) 50%,transparent);box-shadow:0 -14px 40px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.2)}
.sh::before{content:"";display:block;width:44px;height:5px;border-radius:9px;background:color-mix(in srgb,var(--tx) 30%,transparent);margin:8px auto 4px}
.sl>*{box-shadow:0 12px 24px -12px rgba(0,0,0,.6)}
.ts{box-shadow:0 10px 28px rgba(0,0,0,.5),0 0 0 1px color-mix(in srgb,var(--c1) 60%,transparent)}
.aw .bar{box-shadow:0 8px 14px -10px rgba(0,0,0,.6)}
/* ---- Infos et horaires détaillés ---- */
.inf{gap:12px}
.inf>.ib{position:relative;overflow:hidden;padding:12px 14px 12px 18px;border-radius:16px;background:linear-gradient(160deg,color-mix(in srgb,var(--cd) 85%,#fff),var(--cd))}
.inf>.ib::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:linear-gradient(180deg,var(--c1),var(--c2))}
.ih{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.ih i{font-style:normal;display:grid;place-items:center;flex:none;width:30px;height:30px;border-radius:10px;font-size:16px;background:linear-gradient(145deg,var(--c1),color-mix(in srgb,var(--c1) 60%,#000));box-shadow:0 3px 0 color-mix(in srgb,var(--c1) 40%,#000),inset 0 1px 0 rgba(255,255,255,.4)}
.ih b{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--mu)}
.tm{font-size:20px;font-weight:800;line-height:1.25;margin:2px 0 8px;font-variant-numeric:tabular-nums}
.tm small{font-size:11px;font-weight:700;color:var(--c2);margin-left:5px}
.inf .st{display:inline-block;padding:4px 11px;border-radius:99px;background:rgba(0,0,0,.22);box-shadow:inset 0 0 0 1px rgba(217,45,32,.55);color:color-mix(in srgb,#D92D20 55%,var(--tx))}
.inf .st.on{background:rgba(30,158,87,.2);box-shadow:inset 0 0 0 1px rgba(30,158,87,.7);color:color-mix(in srgb,#1E9E57 55%,var(--tx))}
.chs{display:flex;flex-wrap:wrap;gap:8px}
.chp{padding:6px 12px;border-radius:99px;font-size:13px;font-weight:600;background:rgba(0,0,0,.2);box-shadow:inset 0 1px 3px rgba(0,0,0,.3),0 1px 0 rgba(255,255,255,.1)}
.chp.hot{color:#fff;text-shadow:0 1px 1px rgba(0,0,0,.4);background:linear-gradient(135deg,var(--c1),var(--c2));box-shadow:0 3px 8px -3px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.35)}
.hrs{margin:12px 0 4px}
.hrs summary{list-style:none;display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:99px;font-weight:700;color:var(--tx);background:var(--cd);border:1px solid var(--ln);box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.18)}
.hrs summary::-webkit-details-marker{display:none}
.hrs summary::after{content:"\25BE";transition:transform .2s}
.hrs[open] summary::after{transform:rotate(180deg)}
.hrs .t3{align-items:center;padding:10px 12px;margin-top:6px;border-radius:12px;font-size:14px;background:var(--cd);box-shadow:0 5px 12px -8px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.12)}
.hrs .t3 span:first-child{display:flex;flex-direction:column;gap:2px}
.hrs .th3{background:none;box-shadow:none;padding:8px 12px 0;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--mu)}
.t3 em{font-style:normal;font-size:11px;font-weight:800;color:var(--c2)}
.hrs .today{background:linear-gradient(135deg,color-mix(in srgb,var(--c1) 35%,var(--cd)),var(--cd));box-shadow:0 0 0 2px var(--c1),0 10px 18px -8px rgba(0,0,0,.6)}
.hrs .off{opacity:.55}
.hrs small{font-size:10px;font-weight:700;color:var(--c2);margin-left:4px}

/* ---- Titres en 3D ---- */
:root{--x3a:color-mix(in srgb,var(--c1) 78%,#000);--x3b:color-mix(in srgb,var(--c1) 55%,#000);--x3c:color-mix(in srgb,var(--c1) 35%,#000);--x3:-1px -1px 0 rgba(255,255,255,.45),0 1px 0 var(--x3a),0 2px 0 var(--x3a),0 3px 0 var(--x3b),0 4px 0 var(--x3b),0 5px 0 var(--x3c),0 6px 5px rgba(0,0,0,.4),0 10px 16px rgba(0,0,0,.35)}
html[data-t3=off]{--x3:none}
.brand b,.w:not(.aw)>h2,.sh h2,.agc h2,#sp h1{text-shadow:var(--x3);letter-spacing:.01em}
.brand b{padding-bottom:8px}
.w:not(.aw)>h2{padding-bottom:9px}
/* ---- Bouton COMMANDER centré (sans bannière) ---- */
.cta{display:flex;justify-content:center;margin:0 0 10px}
.cta .b{min-width:min(100%,280px);padding:16px 34px;font-size:19px;letter-spacing:.05em;border-radius:16px}
body.an .cta{animation:up .6s .1s both}
/* ---- Villes livrées ---- */
.zg{margin-top:8px;padding:10px 12px;border-radius:12px;background:var(--cd);box-shadow:0 5px 12px -8px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.12)}
.zg>b{display:block;margin-bottom:8px;font-size:18px;color:var(--c2)}

/* ---- Typographies secondaires ---- */
:root{--f2:'DM Sans',system-ui,sans-serif;--f3:'Oswald','Bricolage Grotesque',system-ui,sans-serif}
.mu,.sh p,.tx p,.fq p,.ft,.wn,label,input,select,textarea,.bm,.sp .mu,.cd .mu,.chp,.ol,.pk{font-family:var(--f2)}
.sh .mu,.sh p,.tx p,.fq p{line-height:1.65;font-size:15px}
.ih b,.th3 b,.st,.ch,.lt,.ln,.as span,.trk span,.sb{font-family:var(--f3);text-transform:uppercase;letter-spacing:.09em}
.ch{font-size:13px}.tm,.pp,.num,.tt.big{font-family:var(--f3);letter-spacing:.03em}
.pc .pi .mu{font-family:var(--f3);letter-spacing:.04em}
.pc .pi>b{letter-spacing:-.005em}
.sh h3{font-family:var(--f3);text-transform:uppercase;letter-spacing:.1em;font-size:15px;color:var(--c2)}
.fq summary b{font-family:var(--f2);font-weight:700}
/* ---- Espace client & carte de fidélité ---- */
.lc{position:relative;overflow:hidden;border-radius:20px;padding:16px;margin:14px 0;color:#fff;background:linear-gradient(135deg,var(--c1),color-mix(in srgb,var(--c1) 50%,#000) 70%,color-mix(in srgb,var(--c2) 55%,#000));box-shadow:0 16px 28px -14px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.35)}
.lc::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.14) 50%,transparent 65%)}
.lh{display:flex;justify-content:space-between;align-items:baseline;gap:8px}.lt{font-size:13px;opacity:.9}.lb{font-weight:800;font-size:15px;text-align:right;overflow-wrap:anywhere}
.ls{display:grid;grid-template-columns:repeat(auto-fit,minmax(38px,1fr));gap:8px;margin:14px 0 12px}
.ls i{font-style:normal;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:15px;color:rgba(255,255,255,.65);background:rgba(0,0,0,.28);box-shadow:inset 0 2px 5px rgba(0,0,0,.45),0 1px 0 rgba(255,255,255,.2)}
.ls i.on{background:linear-gradient(145deg,#fff,var(--c2));color:var(--c1);font-size:19px;box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 1px 0 #fff}
.ls i.gf{font-size:19px;border:2px dashed rgba(255,255,255,.6)}.ls i.gf.on{border-color:#fff;background:linear-gradient(145deg,#fff,var(--c2))}
.lf{font-weight:700;line-height:1.3}.ln{font-size:11px;opacity:.85;margin-top:6px}
.pk{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.pk span{padding:10px 12px;border-radius:12px;background:var(--cd);font-size:14px;font-weight:600;box-shadow:0 5px 12px -8px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.12)}
.ah{display:flex;align-items:center;gap:14px;margin:6px 0 12px}.ah h2{font-size:22px}
.av{flex:none;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;font-family:var(--f3);font-size:26px;color:#fff;background:linear-gradient(145deg,var(--c1),var(--c2));box-shadow:0 4px 0 color-mix(in srgb,var(--c1) 45%,#000),inset 0 1px 0 rgba(255,255,255,.4)}
.as{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.as>div{text-align:center;padding:10px 6px;border-radius:14px;background:var(--cd);box-shadow:0 6px 14px -9px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.12)}
.as b{display:block;font-size:18px;font-weight:800;color:var(--c2)}.as span{font-size:10px;color:var(--mu)}
.oc{margin:10px 0;padding:12px 14px;border-radius:16px;background:var(--cd);border-left:4px solid var(--c1);box-shadow:0 8px 18px -10px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.12)}
.trk{display:flex;justify-content:space-between;margin:10px 0}.trk span{flex:1;text-align:center;font-size:10px;color:var(--mu)}.trk i{display:grid;place-items:center;margin:0 auto 4px;width:24px;height:24px;border-radius:50%;font-style:normal;font-weight:800;font-size:12px;background:rgba(0,0,0,.3)}
.trk span.on{color:var(--tx)}.trk span.on i{background:#1E9E57;color:#fff}
.sb{display:inline-block;margin:8px 0;padding:4px 12px;border-radius:99px;font-size:11px;background:rgba(217,45,32,.25);color:#ff8a80}
