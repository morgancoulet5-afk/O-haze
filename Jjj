.tx p,.fq p,.g2 .mu,.sp .mu{font-family:'Fraunces',Georgia,serif;font-style:italic;line-height:1.65}
.pc .pi>b{font-family:var(--f3);text-transform:uppercase;letter-spacing:.04em;font-size:15px}
/* ---- Relief sur toutes les cartes ---- */
.cd,.tx,.fq,.lab,.oc,.lw,.inf>.ib,.g2 .cd,.pk span,.as>div,.hrs .t3,.hrs summary,.zg,.wn,.bm,.pr,.sh .pd{border:1px solid color-mix(in srgb,var(--c1) 38%,var(--ln));background-image:linear-gradient(165deg,rgba(255,255,255,.16),rgba(255,255,255,0) 42%,rgba(0,0,0,.2));box-shadow:inset 0 1px 0 rgba(255,255,255,.32),inset 0 -2px 0 rgba(0,0,0,.28),0 4px 0 color-mix(in srgb,var(--c1) 30%,#000),0 16px 24px -14px rgba(0,0,0,.8)}
.inf>.ib{background-color:var(--cd)}.hrs .today{background-image:linear-gradient(135deg,color-mix(in srgb,var(--c1) 35%,var(--cd)),var(--cd))}
.pc{box-shadow:0 5px 0 color-mix(in srgb,var(--c1) 38%,#000),0 18px 26px -14px rgba(0,0,0,.8),inset 0 1px 0 rgba(255,255,255,.4)}
@media(hover:hover){.g2 .cd,.inf>.ib,.tx,.fq,.oc,.lc,.pk span{transition:transform .25s,box-shadow .25s}.g2 .cd:hover,.inf>.ib:hover,.tx:hover,.fq:hover,.oc:hover,.lc:hover,.pk span:hover{transform:perspective(800px) translateY(-5px) rotateX(2deg);box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 -2px 0 rgba(0,0,0,.28),0 7px 0 color-mix(in srgb,var(--c1) 30%,#000),0 26px 32px -14px rgba(0,0,0,.85)}}

.idb{border-color:var(--c2)!important}.idok{margin:8px 0 0;font-weight:700;color:#1E9E57}

/* --- Accueil plus clair --- */
body::after{filter:blur(2.5px) brightness(.5);transform:scale(1.06)}
.w:not(.aw){display:flex;flex-direction:column}
.w:not(.aw)>h2{text-shadow:0 2px 12px rgba(0,0,0,.9)}
.cd,.tx,.fq,.lab,.oc,.lw,.inf>.ib,.g2 .cd,.pk span,.as>div,.hrs .t3,.hrs summary,.zg{background-image:none;background-color:color-mix(in srgb,var(--cd) 80%,transparent);border:1px solid rgba(255,255,255,.12);box-shadow:0 8px 20px -12px rgba(0,0,0,.8);backdrop-filter:blur(6px)}
.hrs .today{background-image:linear-gradient(135deg,color-mix(in srgb,var(--c1) 30%,transparent),transparent)}
.pc{box-shadow:0 8px 20px -12px rgba(0,0,0,.8)}
.inf{margin:12px 0 8px}.tm{font-size:18px;margin:2px 0 6px}
.g2{gap:8px;margin:10px 0 4px}.g2 .cd{padding:10px 8px}.g2 .mu{font-size:13px;line-height:1.35}
