.sh .pd{margin:8px 0 12px;padding:12px 14px;border-radius:14px;border-left:4px solid var(--c2);background:rgba(0,0,0,.2);box-shadow:inset 0 2px 6px rgba(0,0,0,.3);font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:17px;line-height:1.75;white-space:pre-line;color:var(--tx)}
.ef{margin:8px 0;font-family:var(--f2)}.ef span{display:inline-block;margin-right:8px;padding:2px 10px;border-radius:99px;font-family:var(--f3);text-transform:uppercase;letter-spacing:.1em;font-size:12px;background:var(--c2);color:var(--c2t,#1B1A18)}
.sh .pp{display:inline-block;margin:8px 0;padding:6px 16px;border-radius:12px;font-family:var(--f3);font-size:28px;color:#fff;background:linear-gradient(135deg,var(--c1),var(--c2));box-shadow:0 4px 0 color-mix(in srgb,var(--c1) 45%,#000),0 12px 18px -10px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.4);text-shadow:0 2px 0 rgba(0,0,0,.3)}
